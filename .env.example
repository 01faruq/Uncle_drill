# ==============================================================================
# UNCLE DRILL — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local for local development.
# Reference: src/env.ts & docs/04_SYSTEM_ARCHITECTURE.md
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# URL of your Supabase project (from Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key for client-side queries (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role secret key (NEVER expose to client; used strictly by server modules)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Application Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Founder & Super-Admin Authorization
# Any user account registered with this email is granted 'SUPER_ADMIN' role in
# the public.profiles table and unlocked access to the /command Control Room.
# ------------------------------------------------------------------------------
FOUNDER_ADMIN_EMAIL=founder@uncledrill.com
